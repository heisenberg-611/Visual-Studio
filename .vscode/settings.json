{
    "files.associations": {
        "iostream": "cpp"
    },
    "C_Cpp.errorSquiggles": "enabled",
    "workbench.colorCustomizations": {
        "panel.border": "#0074e6",
        "sash.hoverBorder": "#0074e6",
        "tab.activeBorder": "#0074e6",
        "sideBar.border": "#0074e6",
        "statusBar.background": "#005ab3",
        "statusBar.border": "#005ab3",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#0074e6",
        "statusBarItem.remoteBackground": "#005ab3",
        "statusBarItem.remoteForeground": "#e7e7e7"
    },
    "peacock.color": "#005ab3",
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "./Python",
        "-p",
        "test*.py"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true,
    "liveServer.settings.multiRootWorkspaceName": "Visual Studio",
    "code-runner.customCommand": "cmd",
    "code-runner.clearPreviousOutput": false,
    "code-runner.runInTerminal": true,
    "code-runner.saveAllFilesBeforeRun": true,
    "code-runner.saveFileBeforeRun": true,
    "terminal.integrated.ignoreProcessNames": [
        "starship",
        "oh-my-posh",
        "zsh"
    ],
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "smooth"
}